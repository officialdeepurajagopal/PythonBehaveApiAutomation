{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Behave: ManageBooks",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "behave",
            "args": [
                "--format=plain",
                "--no-capture",
                "tests/feature/ManageBooks.feature"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/tests:${workspaceFolder}/tests/steps"
            }
        }
    ]
}